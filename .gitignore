# Cargo build output
/target/

# Raw evidence belongs in state artifacts or a CI runner temporary directory.
# Tracked historical files still require the committed generated-evidence check.
/docs/proofs/**/*.json
!/docs/proofs/**/artifact.json
/docs/proofs/**/*.gz
/docs/proofs/**/*.zip
/docs/proofs/**/*.tar
/docs/proofs/**/*.csv
/docs/proofs/**/*.tsv
/docs/proofs/**/*.txt
# Nested target dirs so `git add -A` never sweeps build artifacts into a commit.
**/target/
# Even if someone renames a target dir or force-adds, never track rustc
# library products (the May 2026 bloat was mostly libaws_sdk_*.rlib).
**/*.rlib
**/*.rmeta
# JS package installs (if any nested tooling grows them)
**/node_modules/

# OS / editor
.DS_Store
*.swp
*.swo
.idea/
.vscode/
.claude/

# Local env / secrets
.env
.env.local

# Local agent/tool state (gstack, scratch)
.gstack/
.agent-scratch/
.portal-worktree
# A node run from the repo root writes its store to ./data/ (conf, db,
# blobs). Root-anchored so it never matches nested fixture/test `data/` dirs.
/data/

# Generated operational output stays outside Git (Tom, 2026-10-23).
/.evidence/
/.benchmark-output/
/benchmark-results/
/bench-results/
**/__pycache__/
*.pyc
*.log
*.log.gz
*.stdout
*.stderr
# End generated operational output.
