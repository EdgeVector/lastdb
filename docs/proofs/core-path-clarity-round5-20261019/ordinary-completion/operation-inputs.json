{
  "cohort": {
    "concurrent_scope": "Three writer/reader rounds permit only complete old or new field batches. No deterministic internal capture point is claimed.",
    "entry": "run(node)",
    "module": "docs/proofs/core-owned-writes-20261018/cohorts.py",
    "post_cohort_exact_key_controls": "Both geometry key0 records contain revision5. Use exact HashRangeKey, not all keys under a hash.",
    "read_zero_file_rule": "Keep the existing strict write-through assertions.",
    "schema_names": [
      "CoreOwnedWritesHash",
      "CoreOwnedWritesHashRange"
    ],
    "subcohorts": [
      "initial",
      "mixed",
      "no_prior_values",
      "concurrent"
    ],
    "unchanged": true
  },
  "identity_contract": [
    "The same source-schema id UUID remains stable across the source status move.",
    "At each phase current source and peer share all selected atom UUIDs.",
    "The reverse writer key atom UUIDs match the exact framed schema+content hash.",
    "Unrelated record values and UUIDs remain unchanged.",
    "Pre-reopen and post-reopen current UUID maps match exactly.",
    "Only after durable current Delete do source/current-peer/old-peer queries all return no records; unrelated records remain unchanged after normal reopen."
  ],
  "procedure": [
    "Verify the accepted binary, source identity, helper hashes and static request input before any product call.",
    "Create one fresh owned synthetic home and use unchanged default_node.start with api.Node.",
    "Call unchanged cohorts.run once with selected CoreOwnedWritesHashRange preload and the normal key/memory allowances.",
    "Send all20 historical/depth refusal and omitted/null control items in one query batch. Preserve every item status, text and response.",
    "Declare the two distinct protein schemas. Batch-create the source and unrelated record; verify four initial locations.",
    "Send the source key change, then verify five current/old/unrelated locations in one batch. Send the reverse-peer update, then verify those five locations.",
    "Flush, stop normally and reopen. Verify the same five locations and exact current/unrelated atom maps.",
    "Send the additional durable current source Delete. Verify five deleted/unrelated locations. Flush, stop normally and reopen; repeat that five-location check.",
    "Preserve every raw request/response and failure, helper/source/binary identity, normal stop and ownership marker. Seal and prepare exact cleanup preview. Wait for root review before reclaim."
  ],
