  "components": {
    "parameters": {
      "NodeKey": {
        "name": "X-LastDB-Node-Key",
        "in": "header",
        "required": true,
        "schema": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "minLength": 64,
          "maxLength": 64
        }
      },
      "DeviceId": {
        "name": "X-LastDB-Device-Id",
        "in": "header",
        "required": true,
        "schema": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "minLength": 64,
          "maxLength": 64,
          "description": "Hex32 device stream id (32 bytes)"
        }
      },
      "IssuedAt": {
        "name": "X-LastDB-Issued-At",
        "in": "header",
        "required": true,
        "schema": {
          "type": "string",
          "pattern": "^[0-9]+$",
          "maxLength": 20,
          "description": "Unix seconds"
        }
      },
      "Nonce": {
        "name": "X-LastDB-Nonce",
        "in": "header",
        "required": true,
        "schema": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "minLength": 64,
          "maxLength": 64
        }
      },
      "Signature": {
        "name": "X-LastDB-Signature",
        "in": "header",
        "required": true,
        "schema": {
          "type": "string",
          "minLength": 86,
          "maxLength": 88
        }
      },
      "RelayProtocol": {
        "name": "X-LastDB-Relay-Protocol",
        "in": "header",
        "required": true,
        "schema": {
          "type": "integer",
          "enum": [
            1
          ]
        }
      },
      "DatabaseId": {
        "name": "X-LastDB-Database-Id",
        "in": "header",
        "required": true,
        "schema": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "minLength": 64,
          "maxLength": 64
        },
        "description": "Target database_id; covered by nodeSignature"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": [
          "code",
          "field"
        ],
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "unauthorized",
              "forbidden",
              "invalid_request",
              "not_found",
              "conflict",
              "rate_limited",
              "upgrade_required",
              "batch_too_large",
              "payment_required",
              "unavailable"
            ]
          },
          "field": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "minimum_version": {
            "type": "integer",
            "minimum": 1
          }
        }
      },
      "SignedEntry": {
        "type": "object",
        "description": "Opaque signed entry; store key (database_id,node_key,device_id,writer_seq). seen_heads may cite any stream by hash.",
        "required": [
          "kind",
          "database_id",
          "node_key",
          "device_id",
          "writer_seq",
          "prev_hash",
          "signature"
        ],
        "additionalProperties": true,
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "birth",
              "data",
              "bundle",
              "grant",
              "schema",
              "blob_delete",
              "heads",
              "relays"
            ]
          },
          "database_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "minLength": 64,
            "maxLength": 64
          },
          "node_key": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "minLength": 64,
            "maxLength": 64
          },
          "device_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "minLength": 64,
            "maxLength": 64
          },
          "writer_seq": {
            "type": "integer",
            "minimum": 1
          },
          "prev_hash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "minLength": 64,
            "maxLength": 64
          },
          "signature": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{86}$",
            "minLength": 86,
            "maxLength": 86
          }
        }
      },
      "Upload": {
        "type": "object",
        "required": [
          "url",
          "headers",
          "expires_at_ms"
        ],
        "additionalProperties": false,
        "properties": {
          "url": {
            "type": "string",
            "format": "uri",
            "maxLength": 8192
          },
          "headers": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "maxLength": 1024
            },
            "maxProperties": 32
          },
          "expires_at_ms": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "PresignedGet": {
        "type": "object",
        "required": [
          "url",
          "headers",
          "expires_at_ms",
          "bytes",
          "sha256"
        ],
        "additionalProperties": false,
        "description": "Exactly one download path: presigned URL",
        "properties": {
          "url": {
            "type": "string",
            "format": "uri",
            "maxLength": 8192
          },
          "headers": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "maxLength": 1024
            },
            "maxProperties": 32
          },
          "expires_at_ms": {
            "type": "integer",
            "minimum": 0
          },
          "bytes": {
            "type": "integer",
            "minimum": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "minLength": 64,
            "maxLength": 64
          }
        }
      },
      "LogAppendBody": {
        "type": "object",
        "required": [
          "database_id",
          "entries"
        ],
        "additionalProperties": false,
        "properties": {
          "database_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "minLength": 64,
            "maxLength": 64
          },
          "entries": {
            "type": "array",
            "minItems": 1,
            "maxItems": 90,
            "items": {
              "$ref": "#/components/schemas/SignedEntry"
            }
          }
        }
      },
      "LogAppendResult": {
        "type": "object",
        "required": [
          "stored"
        ],
        "additionalProperties": false,
        "properties": {
          "stored": {
            "type": "integer",
            "minimum": 0
          },
          "duplicate": {
            "type": "boolean"
          }
        }
      },
      "LogReadBody": {
        "type": "object",
        "required": [
          "database_id"
        ],
        "additionalProperties": false,
        "properties": {
          "database_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "minLength": 64,
            "maxLength": 64
          },
          "writer_key": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "minLength": 64,
            "maxLength": 64
          },
          "device_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "minLength": 64,
            "maxLength": 64
          },
          "from_seq": {
            "type": "integer",
            "minimum": 1
          },
          "cursor": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "description": "Pagination only; never expires"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 90
          }
        }
      },
      "LogReadResult": {
        "type": "object",
        "required": [
          "entries"
        ],
        "additionalProperties": false,
        "properties": {
          "cursor": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
