{
  "openapi": "3.1.0",
  "info": {
    "title": "LastDB relay protocol",
    "version": "1.0.0-design",
    "description": "Append-only log (except product erase); blobs; signed requests; spam/cost grant gate from publisher birth/grant entries; bundles via blob.put/get; no AcceptEntry on the relay; no snapshots."
  },
  "paths": {
    "/relay/v1/log/append": {
      "post": {
        "summary": "Append signed log entries (append-only, never trimmed)",
        "parameters": [
          {
            "$ref": "#/components/parameters/NodeKey"
          },
          {
            "$ref": "#/components/parameters/DatabaseId"
          },
          {
            "$ref": "#/components/parameters/DeviceId"
          },
          {
            "$ref": "#/components/parameters/IssuedAt"
          },
          {
            "$ref": "#/components/parameters/Nonce"
          },
          {
            "$ref": "#/components/parameters/Signature"
          },
          {
            "$ref": "#/components/parameters/RelayProtocol"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LogAppendBody"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LogAppendResult"
                }
              }
            }
          },
          "401": {
            "description": "request auth",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "quota / rate limit",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "rate_limited": {
                    "value": {
                      "code": "rate_limited",
                      "field": "quota"
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "unknown or service error; retry",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "unavailable": {
                    "value": {
                      "code": "unavailable",
                      "field": "provider.dynamo"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "arg paths / grants.any.role / batch.response, entries.signature, incorporated_from",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "invalid_request": {
                    "value": {
                      "code": "invalid_request",
                      "field": "example"
                    }
                  },
                  "batch_too_large": {
                    "value": {
                      "code": "batch_too_large",
                      "field": "example"
                    }
                  },
                  "grants_any_role": {
                    "summary": "any grantee must be read",
                    "value": {
                      "code": "invalid_request",
                      "field": "grants.any.role"
                    }
                  }
                }
              }
            }
          },
          "426": {
            "description": "request.protocol",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "upgrade_required": {
                    "value": {
                      "code": "upgrade_required",
                      "field": "example"
                    }
                  }
                }
              }
            }
          },
          "403": {
            "description": "no current grant for this node_key / role",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "forbidden": {
                    "value": {
                      "code": "forbidden",
                      "field": "grant"
                    }
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "nodeSignature": []
          }
        ],
        "description": "Requires nodeSignature. Accepted for the publisher, or for a current submit or write grant when the entries are proposal data on the caller's own stream; direct data, bundle and publisher kinds are the publisher's alone. Revoke cuts off new appends immediately (403). Spam/cost gate only \u2014 not AcceptEntry."
      }
    },
