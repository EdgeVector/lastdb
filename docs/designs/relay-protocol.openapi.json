                    "value": {
                      "code": "forbidden",
                      "field": "grant"
                    }
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "nodeSignature": []
          }
        ],
        "description": "Requires nodeSignature. Allowed with a current read grant, or grant#any/read (any signed caller). Not unsigned/anonymous."
      }
