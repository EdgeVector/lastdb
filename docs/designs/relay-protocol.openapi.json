{
  "openapi": "3.1.0",
  "info": {
    "title": "LastDB relay protocol",
    "version": "1.0.0-design",
    "description": "Append-only log; content-addressed blobs/snapshots; presigned GET only. No retention.request. Acceptance is AcceptEntry on nodes."
  },
  "paths": {
    "/relay/v1/log/append": {
      "post": {
        "summary": "Append signed log entries (append-only)",
        "parameters": [
          {
            "$ref": "#/components/parameters/NodeKey"
          },
          {
            "$ref": "#/components/parameters/DeviceId"
          },
          {
            "$ref": "#/components/parameters/IssuedAt"
          },
          {
            "$ref": "#/components/parameters/Nonce"
          },
          {
            "$ref": "#/components/parameters/Signature"
          },
          {
            "$ref": "#/components/parameters/RelayProtocol"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LogAppendBody"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LogAppendResult"
                }
              }
            }
          },
          "401": {
            "description": "request auth",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/relay/v1/log/read": {
      "post": {
        "summary": "Read signed log entries",
        "parameters": [
          {
            "$ref": "#/components/parameters/NodeKey"
          },
          {
            "$ref": "#/components/parameters/DeviceId"
          },
          {
            "$ref": "#/components/parameters/IssuedAt"
          },
          {
            "$ref": "#/components/parameters/Nonce"
          },
          {
            "$ref": "#/components/parameters/Signature"
          },
          {
            "$ref": "#/components/parameters/RelayProtocol"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LogReadBody"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LogReadResult"
                }
              }
            }
          },
          "401": {
            "description": "request auth",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/relay/v1/blob/put": {
      "post": {
        "summary": "Put blob",
        "parameters": [
          {
            "$ref": "#/components/parameters/NodeKey"
          },
          {
            "$ref": "#/components/parameters/DeviceId"
          },
          {
            "$ref": "#/components/parameters/IssuedAt"
          },
          {
            "$ref": "#/components/parameters/Nonce"
          },
          {
            "$ref": "#/components/parameters/Signature"
          },
          {
            "$ref": "#/components/parameters/RelayProtocol"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BlobPutBody"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BlobPutResult"
                }
              }
            }
          },
          "401": {
            "description": "request auth",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/relay/v1/blob/get": {
      "post": {
        "summary": "Get blob via presigned URL only",
        "parameters": [
          {
            "$ref": "#/components/parameters/NodeKey"
          },
          {
            "$ref": "#/components/parameters/DeviceId"
          },
          {
            "$ref": "#/components/parameters/IssuedAt"
          },
          {
            "$ref": "#/components/parameters/Nonce"
          },
          {
            "$ref": "#/components/parameters/Signature"
          },
          {
            "$ref": "#/components/parameters/RelayProtocol"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BlobGetBody"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PresignedGet"
                }
              }
            }
          },
          "401": {
            "description": "request auth",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "blob.sha256 (including after blob_delete)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/relay/v1/snapshot/put": {
      "post": {
        "summary": "Put snapshot (non-authoritative)",
        "parameters": [
          {
            "$ref": "#/components/parameters/NodeKey"
          },
          {
            "$ref": "#/components/parameters/DeviceId"
          },
          {
            "$ref": "#/components/parameters/IssuedAt"
          },
          {
            "$ref": "#/components/parameters/Nonce"
          },
          {
            "$ref": "#/components/parameters/Signature"
          },
          {
            "$ref": "#/components/parameters/RelayProtocol"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SnapshotPutBody"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SnapshotPutResult"
                }
              }
            }
          },
          "401": {
            "description": "request auth",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/relay/v1/snapshot/get": {
      "post": {
        "summary": "Get snapshot via presigned URL only",
        "parameters": [
          {
            "$ref": "#/components/parameters/NodeKey"
          },
          {
            "$ref": "#/components/parameters/DeviceId"
          },
          {
            "$ref": "#/components/parameters/IssuedAt"
          },
          {
            "$ref": "#/components/parameters/Nonce"
          },
          {
            "$ref": "#/components/parameters/Signature"
          },
          {
            "$ref": "#/components/parameters/RelayProtocol"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SnapshotGetBody"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SnapshotGetResult"
                }
              }
            }
          },
          "401": {
            "description": "request auth",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "parameters": {
      "NodeKey": {
        "name": "X-LastDB-Node-Key",
        "in": "header",
        "required": true,
        "schema": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "minLength": 64,
          "maxLength": 64
        }
      },
      "DeviceId": {
        "name": "X-LastDB-Device-Id",
        "in": "header",
        "required": true,
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      },
      "IssuedAt": {
        "name": "X-LastDB-Issued-At",
        "in": "header",
        "required": true,
        "schema": {
          "type": "string",
          "pattern": "^[0-9]+$",
          "maxLength": 20
        }
      },
      "Nonce": {
        "name": "X-LastDB-Nonce",
        "in": "header",
        "required": true,
        "schema": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "minLength": 64,
          "maxLength": 64
        }
      },
      "Signature": {
        "name": "X-LastDB-Signature",
        "in": "header",
        "required": true,
        "schema": {
          "type": "string",
          "minLength": 86,
          "maxLength": 88
        }
      },
      "RelayProtocol": {
        "name": "X-LastDB-Relay-Protocol",
        "in": "header",
        "required": true,
        "schema": {
          "type": "integer",
          "enum": [
            1
          ]
        }
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": [
          "code",
          "field"
        ],
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "unauthorized",
              "forbidden",
              "invalid_request",
              "not_found",
              "conflict",
              "rate_limited",
              "upgrade_required",
              "batch_too_large",
              "payment_required"
            ]
          },
          "field": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "minimum_version": {
            "type": "integer",
            "minimum": 1
          }
        }
      },
      "DatabaseId": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$",
        "minLength": 64,
        "maxLength": 64
      },
      "Sha256Hex": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$",
        "minLength": 64,
        "maxLength": 64
      },
      "OpaqueCursor": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      },
      "SignedEntry": {
        "type": "object",
        "description": "Opaque signed entry; store key (database_id,node_key,device_id,writer_seq). Full schemas in cloud-api.openapi.json.",
        "required": [
          "kind",
          "database_id",
          "node_key",
          "device_id",
          "writer_seq",
          "prev_hash",
          "signature"
        ],
        "additionalProperties": true,
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "birth",
              "data",
              "grant",
              "blob_delete",
              "heads",
              "relays",
              "resolve"
            ]
          },
          "database_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "minLength": 64,
            "maxLength": 64
          },
          "node_key": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "minLength": 64,
            "maxLength": 64
          },
          "device_id": {
            "type": "string",
            "format": "uuid"
          },
          "writer_seq": {
            "type": "integer",
            "minimum": 1
          },
          "prev_hash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "minLength": 64,
            "maxLength": 64
          },
          "signature": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{86}$",
            "minLength": 86,
            "maxLength": 86
          }
        }
      },
      "Upload": {
        "type": "object",
        "required": [
          "url",
          "headers",
          "expires_at_ms"
        ],
        "additionalProperties": false,
        "properties": {
          "url": {
            "type": "string",
            "format": "uri",
            "maxLength": 8192
          },
          "headers": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "maxLength": 1024
            },
            "maxProperties": 32
          },
          "expires_at_ms": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "PresignedGet": {
        "type": "object",
        "required": [
          "url",
          "headers",
          "expires_at_ms",
          "bytes",
          "sha256"
        ],
        "additionalProperties": false,
        "description": "Exactly one download path: presigned URL",
        "properties": {
          "url": {
            "type": "string",
            "format": "uri",
            "maxLength": 8192
          },
          "headers": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "maxLength": 1024
            },
            "maxProperties": 32
          },
          "expires_at_ms": {
            "type": "integer",
            "minimum": 0
          },
          "bytes": {
            "type": "integer",
            "minimum": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "minLength": 64,
            "maxLength": 64
          }
        }
      },
      "LogAppendBody": {
        "type": "object",
        "required": [
          "database_id",
          "entries"
        ],
        "additionalProperties": false,
        "properties": {
          "database_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "minLength": 64,
            "maxLength": 64
          },
          "entries": {
            "type": "array",
            "minItems": 1,
            "maxItems": 90,
            "items": {
              "$ref": "#/components/schemas/SignedEntry"
            }
          }
        }
      },
      "LogAppendResult": {
        "type": "object",
        "required": [
          "stored"
        ],
        "additionalProperties": false,
        "properties": {
          "stored": {
            "type": "integer",
            "minimum": 0
          },
          "duplicate": {
            "type": "boolean"
          }
        }
      },
      "LogReadBody": {
        "type": "object",
        "required": [
          "database_id"
        ],
        "additionalProperties": false,
        "properties": {
          "database_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "minLength": 64,
            "maxLength": 64
          },
          "writer_key": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "minLength": 64,
            "maxLength": 64
          },
          "device_id": {
            "type": "string",
            "format": "uuid"
          },
          "from_seq": {
            "type": "integer",
            "minimum": 1
          },
          "cursor": {
            "$ref": "#/components/schemas/OpaqueCursor"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 90
          }
        }
      },
      "LogReadResult": {
        "type": "object",
        "required": [
          "entries"
        ],
        "additionalProperties": false,
        "properties": {
          "cursor": {
            "$ref": "#/components/schemas/OpaqueCursor"
          },
          "entries": {
            "type": "array",
            "maxItems": 90,
            "items": {
              "$ref": "#/components/schemas/SignedEntry"
            }
          }
        }
      },
      "BlobPutBody": {
        "type": "object",
        "required": [
          "database_id",
          "stage",
          "bytes",
          "sha256"
        ],
        "additionalProperties": false,
        "properties": {
          "database_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "minLength": 64,
            "maxLength": 64
          },
          "stage": {
            "type": "string",
            "enum": [
              "begin",
              "commit"
            ]
          },
          "bytes": {
            "type": "integer",
            "minimum": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "minLength": 64,
            "maxLength": 64
          }
        }
      },
      "BlobPutResult": {
        "type": "object",
        "required": [
          "stage",
          "sha256"
        ],
        "additionalProperties": false,
        "properties": {
          "stage": {
            "type": "string",
            "enum": [
              "begin",
              "commit"
            ]
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "minLength": 64,
            "maxLength": 64
          },
          "upload": {
            "$ref": "#/components/schemas/Upload"
          }
        }
      },
      "BlobGetBody": {
        "type": "object",
        "required": [
          "database_id",
          "sha256"
        ],
        "additionalProperties": false,
        "properties": {
          "database_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "minLength": 64,
            "maxLength": 64
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "minLength": 64,
            "maxLength": 64
          }
        }
      },
      "SnapshotPutBody": {
        "type": "object",
        "required": [
          "database_id",
          "stage"
        ],
        "additionalProperties": false,
        "properties": {
          "database_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "minLength": 64,
            "maxLength": 64
          },
          "stage": {
            "type": "string",
            "enum": [
              "begin",
              "commit"
            ]
          },
          "snapshot_upload": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "manifest_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "minLength": 64,
            "maxLength": 64
          },
          "covered_heads": {
            "type": "array",
            "maxItems": 4096,
            "items": {
              "type": "object",
              "required": [
                "node_key",
                "device_id",
                "writer_seq",
                "entry_hash"
              ],
              "additionalProperties": false,
              "properties": {
                "node_key": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$",
                  "minLength": 64,
                  "maxLength": 64
                },
                "device_id": {
                  "type": "string",
                  "format": "uuid"
                },
                "writer_seq": {
                  "type": "integer",
                  "minimum": 1
                },
                "entry_hash": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$",
                  "minLength": 64,
                  "maxLength": 64
                }
              }
            }
          }
        }
      },
      "SnapshotPutResult": {
        "type": "object",
        "required": [
          "stage"
        ],
        "additionalProperties": false,
        "properties": {
          "stage": {
            "type": "string",
            "enum": [
              "begin",
              "commit"
            ]
          },
          "snapshot_upload": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "restore_point_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "minLength": 64,
            "maxLength": 64
          }
        }
      },
      "SnapshotGetBody": {
        "type": "object",
        "required": [
          "database_id"
        ],
        "additionalProperties": false,
        "properties": {
          "database_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "minLength": 64,
            "maxLength": 64
          },
          "restore_point_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "minLength": 64,
            "maxLength": 64
          }
        }
      },
      "SnapshotGetResult": {
        "type": "object",
        "required": [
          "restore_point_id",
          "manifest_sha256",
          "url",
          "headers",
          "expires_at_ms",
          "bytes",
          "sha256"
        ],
        "additionalProperties": false,
        "description": "Presigned URL only; covered_heads for restore verify",
        "properties": {
          "restore_point_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "minLength": 64,
            "maxLength": 64
          },
          "manifest_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "minLength": 64,
            "maxLength": 64
          },
          "covered_heads": {
            "type": "array",
            "maxItems": 4096,
            "items": {
              "type": "object",
              "required": [
                "node_key",
                "device_id",
                "writer_seq",
                "entry_hash"
              ],
              "additionalProperties": false,
              "properties": {
                "node_key": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$",
                  "minLength": 64,
                  "maxLength": 64
                },
                "device_id": {
                  "type": "string",
                  "format": "uuid"
                },
                "writer_seq": {
                  "type": "integer",
                  "minimum": 1
                },
                "entry_hash": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$",
                  "minLength": 64,
                  "maxLength": 64
                }
              }
            }
          },
          "url": {
            "type": "string",
            "format": "uri",
            "maxLength": 8192
          },
          "headers": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "maxLength": 1024
            },
            "maxProperties": 32
          },
          "expires_at_ms": {
            "type": "integer",
            "minimum": 0
          },
          "bytes": {
            "type": "integer",
            "minimum": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "minLength": 64,
            "maxLength": 64
          }
        }
      }
    }
  }
}
