#!/usr/bin/env python3
"""Remember people and share databases from the selected LastDB home."""

from http.client import HTTPException
from pathlib import Path
import shutil
import subprocess
import sys

sys.dont_write_bytecode = True

from app import SocialApp
from cli import parser
from commands import HANDLERS
from lastdb import LastDB, SocialError
from output import emit


def main():
    args = parser().parse_args()
    try:
        executable = args.lastdb or shutil.which("lastdb")
        if not executable:
            raise SocialError("supply --lastdb or put lastdb on PATH")
        app = SocialApp(LastDB(args.data_dir, Path(executable)))
        command = " ".join(filter(None, (args.noun, getattr(args, "verb", None))))
        result = HANDLERS[command](app, args)
    except (SocialError, OSError, HTTPException, subprocess.SubprocessError, ValueError, KeyError) as error:
        detail = str(error)
        if isinstance(error, OSError) and not error.filename:
            detail = f"could not reach LastDB in {args.data_dir} ({error})"
        print(f"social: {' '.join(detail.split())}", file=sys.stderr)
        return 1
    emit(result, args.json, sys.stdout)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
