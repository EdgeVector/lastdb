#!/usr/bin/env python3
"""Read the standard vocabulary. New fields use normal schema or field declaration.

This command reads public definitions. It never retrieves a signing key,
changes the vocabulary, or opens a LastDB home.
"""
import argparse
import json
import sys
import urllib.parse
import urllib.request


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--url', required=True, help='Schema service base URL')
    parser.add_argument('action', choices=['get'], help='Read current definitions')
    args = parser.parse_args()
    url = urllib.parse.urlsplit(args.url)
    if url.scheme != 'https' or not url.netloc or url.username or url.password:
        parser.error('--url requires HTTPS without credentials')
    endpoint = args.url.rstrip('/') + '/v1/fields/vocabulary'
    with urllib.request.urlopen(endpoint, timeout=60) as response:
        result = json.load(response)
    print(json.dumps(result, indent=2, ensure_ascii=False))


if __name__ == '__main__':
    try:
        main()
    except (ValueError, OSError) as error:
        print(f'Canonical vocabulary command failed: {type(error).__name__}', file=sys.stderr)
        sys.exit(1)
