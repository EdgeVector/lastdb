{
 "name": "20-canonical-levels",
 "note": "Units follow schema -> field -> molecule -> atom -> file. warm_set is a cache over molecule/atom; cloud sits beside file; shared is the leaf.",
 "mixed_files": {
  "atom/mod.rs": "molecule (KeyMetadata, LWW order, molecule uuid) + atom re-exports",
  "db_operations/atom_store/mod.rs": "atom (AtomStore struct) + molecule state: tip locks, delete barriers, MoleculeKeyStore, keep-small meters",
  "db_operations/atom_store/construct.rs": "atom + molecule (same struct)",
  "db_operations/atom_store/counter/commit.rs": "molecule (tip records) + atom (bodies, counters, blob counters) in one batch",
  "storage/disk_pack/mod.rs": "file (PackRuntime, run homes) + warm_set (owns CoreWarmSet)",
  "storage/disk_pack/transaction.rs": "file (complete request, disk publication) + warm_set (core memory publication)",
  "storage/disk_pack/view.rs": "file (disk root) + warm_set (typed core read view)",
  "storage/current_keys.rs": "file (scope codec) + key classifier for every level",
  "schema/types/field/common.rs": "field (FieldCommon) + file (build_storage_key)",
  "schema/types/operations/mod.rs": "schema (Query, MutationType) + field (ValueFilter, FieldPredicate)",
  "schema/types/key_value.rs": "molecule (key value) + schema (key comparison contract)",
  "sharing/delivery_wire/types.rs": "cloud (slice payload) + file (FileBlobAccess)",
  "sharing/delivery_wire/blob.rs": "cloud (slice atoms) + file (blob decode)",
  "sharing/delivery_wire/validate.rs": "cloud (slice validation) + file/atom (file access, pointer thumbnails)",
  "storage/disk_pack/file_dependencies/metadata.rs": "atom (file refs of bodies) + molecule (file refs in tip metadata)",
  "db_operations/molecule_key_store.rs": "molecule (key bundles) + schema (per-schema contract)"
 },
